# =============================================================================
# gitignore_template.txt
# Rename this file to  .gitignore  before pushing to GitHub.
# Author: Ayan Dutta  |  Project: Enterprise SIEM Lab
# =============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# ── Jupyter Notebook ──────────────────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ── Generated runtime artifacts ───────────────────────────────────────────────
# These files are generated by running notebook cells — do NOT commit
siem_sim.log
docker-compose.yml
deploy_agent.sh
ossec.conf
local_rules.xml
es_queries.json
panel1_timeline.png
panel2_top_ips.png
panel3_mitre.png
panel4_agent_health.png
results_summary.png

# ── MS Word / Office temp lock files ─────────────────────────────────────────
~$*.docx
~$*.xlsx
~$*.pptx

# ── OS files ──────────────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
*~

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── Logs & temp ───────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.swp

# ── Secrets / credentials ─────────────────────────────────────────────────────
.env
.env.*
secrets.yml
secrets.json
config/wazuh_indexer_ssl_certs/

# ── Tool temp ─────────────────────────────────────────────────────────────────
.bob/
